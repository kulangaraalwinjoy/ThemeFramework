{
    "name": "kulangaraalwinjoy/wp-theme-framework",
    "description": "A production-ready, declarative PHP package for WordPress theme development. Vibe Coded by Alwin Joy.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Alwin Joy",
            "email": "kulangaraalwinjoy@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "php-stubs/wordpress-stubs": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "KulangaraAlwinJoy\\ThemeFramework\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KulangaraAlwinJoy\\ThemeFramework\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G --debug",
        "format": "phpcbf"
    }
}
